# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token
TUNNEL_TOKEN=
# Public hostname you mapped to http://relay:18421 in the tunnel
RELAY_PUBLIC_URL=https://relay.android-backstage.com
# Optional: enables POST /v1/accounts for multi-tenant use
RELAY_ADMIN_TOKEN=
RELAY_MAX_FILE_MB=512
RELAY_ENABLE_LEARN=0
