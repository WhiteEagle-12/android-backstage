# Zero-Extra-Cost GCP + Cloudflare Deployment Config (example — copy to /etc/android-backstage/env, mode 0600)

# Public origin served behind Cloudflare Tunnel (or Caddy + Cloudflare Proxy)
BACKSTAGE_RELAY_URL=https://relay.android-backstage.com
BACKSTAGE_RELAY_INTERNAL_URL=http://127.0.0.1:18420
BACKSTAGE_WORK_BASE=https://relay.android-backstage.com/work
RELAY_PUBLIC_URL=https://relay.android-backstage.com

# Persistent local disk directories (30 GB GCP PD, backed up daily)
RELAY_DATA_DIR=/var/lib/android-backstage/relay
BACKSTAGE_WORK_STATE=/var/lib/android-backstage/work
BACKSTAGE_APP_RELEASES=/var/lib/android-backstage/app-releases

# Production hardening
BACKSTAGE_CLOUD_MODE=1
BACKSTAGE_DIRECT_ROUTES=0
RELAY_ENABLE_LEARN=0
RELAY_ADMIN_TOKEN=REPLACE_WITH_32_BYTE_RANDOM_TOKEN

# Transactional sign-in email (Resend free tier: 3,000 emails/mo, $0)
BACKSTAGE_RESEND_API_KEY=re_REPLACE_ME
BACKSTAGE_MAIL_FROM=Android Backstage <login@android-backstage.com>

# Optional: Cloudflare R2 ($0 egress!) for encrypted file / APK / MP4 transfers
# Create a private R2 bucket with a 1-day object expiration lifecycle rule.
# RELAY_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# RELAY_R2_BUCKET=backstage-relay-files
# RELAY_R2_ACCESS_KEY_ID=REPLACE_ME
# RELAY_R2_SECRET_ACCESS_KEY=REPLACE_ME
# RELAY_R2_REGION=auto
# RELAY_R2_PREFIX=relay-files/
